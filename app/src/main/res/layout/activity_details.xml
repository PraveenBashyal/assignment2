<?xml version="1.0" encoding="utf-8"?>
<!-- Details screen showing all information for one selected Fitness exercise. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Arrow-only back button. -->
        <TextView
            android:id="@+id/buttonBackToDashboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#E9DCF7"
            android:clickable="true"
            android:contentDescription="Back to dashboard"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="#5A2677"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Selected exercise name. -->
        <TextView
            android:id="@+id/textViewDetailsExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#2D1B45"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Exercise information and training summary"
            android:textColor="#67576F"
            android:textSize="15sp" />

        <!-- Card containing the exercise summary values. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Training summary"
                android:textColor="#2D1B45"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewDetailsMuscleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#4A3D52"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewDetailsEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#4A3D52"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewDetailsDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#4A3D52"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewDetailsCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#4A3D52"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Card containing the full description. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#2D1B45"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewDetailsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:textColor="#4A3D52"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>